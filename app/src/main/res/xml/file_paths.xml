<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 共享路径：导出日志、打开/安装已下载文件等场景使用 -->
<paths>
    <!-- 内部缓存目录：cacheDir/logs -->
    <cache-path name="cache_logs" path="logs/" />
    <!-- 崩溃日志目录：filesDir/crash -->
    <files-path name="files_crash" path="crash/" />
    <!-- 公共下载目录：Environment.getExternalStoragePublicDirectory(DIRECTORY_DOWNLOADS)（Android 9- 保存位置） -->
    <external-path name="downloads" path="Download/" />
</paths>
